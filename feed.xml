---
layout: null
sitemap: false
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">{% assign feed_pages = site.html_pages | where_exp: "page", "page.search_page != true" | where_exp: "page", "page.tool_page != true" | where_exp: "page", "page.robots != 'noindex'" | where_exp: "page", "page.url != '/404.html'" | sort: "url" | reverse %}<generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator><link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml" /><link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" hreflang="{{ site.lang | default: 'en' }}" /><updated>{{ site.time | date_to_xmlschema }}</updated><id>{{ site.url }}{{ site.baseurl }}/feed.xml</id><title type="html">{{ site.title | xml_escape }}</title>{% if site.description %}<subtitle>{{ site.description | xml_escape }}</subtitle>{% endif %}{% for page in feed_pages limit: 40 %}<entry><id>{{ site.url }}{{ site.baseurl }}{{ page.url }}</id><link href="{{ site.url }}{{ site.baseurl }}{{ page.url }}" rel="alternate" type="text/html" /><title type="html">{{ page.title | default: page.display_title | xml_escape }}</title><published>{{ page.date | default: site.time | date_to_xmlschema }}</published><updated>{{ page.last_modified_at | default: page.date | default: site.time | date_to_xmlschema }}</updated><summary type="html">{{ page.description | default: page.excerpt | strip_html | xml_escape | truncate: 300 }}</summary></entry>
{% endfor %}</feed>
